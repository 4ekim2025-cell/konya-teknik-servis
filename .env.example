# Server-only Instagram Graph API credentials. Never use the VITE_ prefix.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# Blog paneli (/yonetim/) — yalnızca sunucu tarafı. Asla VITE_ önekiyle kullanma ve Git'e ekleme.
# ADMIN_PASSWORD_HASH: `pnpm admin:hash` çıktısı. ADMIN_SESSION_SECRET: en az 32 karakter rastgele metin (aynı komut üretir).
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
# Yalnızca bu depoda "Contents: read/write" izni olan ince ayarlı (fine-grained) GitHub token.
GITHUB_CONTENT_TOKEN=
# İsteğe bağlı: varsayılanlar 4ekim2025-cell/konya-teknik-servis ve main (önizlemede önizlemenin kendi dalı).
GITHUB_REPO=
GITHUB_BRANCH=

# Yapay zeka taslağı (panel → "Yapay zeka ile taslak") — yalnızca sunucu tarafı. Asla VITE_ önekiyle kullanma ve Git'e ekleme.
# GEMINI_API_KEY: https://aistudio.google.com/apikey (ücretsiz katman; faturalandırma açmayın).
GEMINI_API_KEY=
# İsteğe bağlı: model adı (varsayılan gemini-flash-latest), yedek sağlayıcı Groq (https://console.groq.com/keys) ve günlük taslak sınırı (varsayılan 20).
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
AI_DAILY_LIMIT=
